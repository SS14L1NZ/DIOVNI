<pda:PdaWindow  xmlns="https://spacestation14.io"
                xmlns:pda="clr-namespace:Content.Client.PDA"
                MouseFilter="Stop">

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!-- BASE LAYERS (full-window overlays for body fill and border)  -->
    <!-- ══════════════════════════════════════════════════════════════ -->

    <!-- Primary body fill — tintable via PdaBorderColorComponent -->
    <PanelContainer Name="Background" Access="Public" StyleClasses="PdaBodyPlastic" />
    <!-- Decorative accent bands (hidden by default, coloured by PdaBorderColorComponent) -->
    <PanelContainer Name="AccentH" Margin="-1 175 -2 175" Access="Public" StyleClasses="PdaBackground" />
    <PanelContainer Name="AccentV" Margin="260 -1 260 -1" Access="Public" StyleClasses="PdaBackground" />
    <!-- Angular outer border frame -->
    <PanelContainer Name="Border" StyleClasses="PdaBorderRect" />

    <!-- ══════════════════════════════════════════════════════════════ -->
    <!-- HOUSING STRUCTURE — 3-column layout: Rail │ Body │ Wing      -->
    <!-- ══════════════════════════════════════════════════════════════ -->
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">

        <!-- ▐ LEFT: Metal Rail Frame ▐ -->
        <PanelContainer StyleClasses="PdaCaseMetalPanel" SetWidth="48" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="0 10">
                <!-- Top chamfer highlight -->
                <PanelContainer StyleClasses="PdaCaseChamferLight" SetHeight="3" HorizontalExpand="True" Margin="4 0 2 0" />
                <Control SetHeight="6" />
                <!-- Rail bevel line (top) -->
                <PanelContainer StyleClasses="PdaCaseRailBevel" SetHeight="2" HorizontalExpand="True" Margin="6 0 4 0" />
                <Control SetHeight="45" />

                <!-- Handle cutout — hard shadow technique -->
                <Control SetHeight="105" HorizontalExpand="True" Margin="8 0 6 0">
                    <PanelContainer StyleClasses="PdaCaseHandleShadow" Margin="3 3 0 0" />
                    <PanelContainer StyleClasses="PdaCaseHandleVoid" Margin="0 0 3 3" />
                </Control>

                <!-- Flexible spacer -->
                <Control VerticalExpand="True" />

                <!-- Speaker / vent grooves -->
                <PanelContainer StyleClasses="PdaCaseGroove" SetHeight="2" Margin="12 0 14 0" HorizontalExpand="True" />
                <Control SetHeight="5" />
                <PanelContainer StyleClasses="PdaCaseGroove" SetHeight="2" Margin="12 0 14 0" HorizontalExpand="True" />
                <Control SetHeight="5" />
                <PanelContainer StyleClasses="PdaCaseGroove" SetHeight="2" Margin="12 0 14 0" HorizontalExpand="True" />
                <Control SetHeight="5" />
                <PanelContainer StyleClasses="PdaCaseGroove" SetHeight="2" Margin="12 0 14 0" HorizontalExpand="True" />
                <Control SetHeight="30" />

                <!-- Rail bevel line (bottom) -->
                <PanelContainer StyleClasses="PdaCaseRailBevel" SetHeight="2" HorizontalExpand="True" Margin="6 0 4 0" />
                <Control SetHeight="4" />
            </BoxContainer>
        </PanelContainer>

        <!-- Rail → Body junction seam (light highlight + dark shadow) -->
        <PanelContainer StyleClasses="PdaCaseSeamHighlight" SetWidth="2" VerticalExpand="True" />
        <PanelContainer StyleClasses="PdaCaseSeamShadow" SetWidth="2" VerticalExpand="True" />

        <!-- ▐ CENTER: Main Plastic Body ▐ -->
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">

            <!-- Top ridge bar — metal accent strip -->
            <Control SetHeight="8" HorizontalExpand="True">
                <PanelContainer StyleClasses="PdaCaseTopRidge" />
            </Control>

            <!-- Close button heading -->
            <BoxContainer SetHeight="22" Margin="4 1 8 0" Orientation="Horizontal">
                <Control HorizontalExpand="True"/>
                <TextureButton Name="CloseButton" StyleClasses="windowCloseButton"
                               VerticalAlignment="Center" Margin="0 2 4 0"/>
            </BoxContainer>

            <!-- Screen bezel outer edge (top) -->
            <PanelContainer StyleClasses="PdaCaseBezelEdge" SetHeight="4" HorizontalExpand="True" Margin="8 0" />

            <!-- ═══ SCREEN AREA — internals untouched ═══ -->
            <Control Margin="8 0" RectClipContent="True" VerticalExpand="true"
                     HorizontalExpand="True">
                <PanelContainer Name="ContentBorder" StyleClasses="PdaBackground"/>
                <Control Margin="3 3">
                    <PanelContainer Name="ContentBackground" StyleClasses="PdaContentBackground"/>
                    <BoxContainer Access="Public" Name="ContentsContainer" Orientation="Vertical" StyleClasses="PdaContent"/>
                    <TextureRect Name="ScreenEffectOverlay"
                                 Access="Public"
                                 MouseFilter="Ignore"
                                 HorizontalExpand="True"
                                 VerticalExpand="True"
                                 Stretch="Scale"
                                 TexturePath="/Textures/Interface/Nano/square_black.png"/>
                    <TextureRect Name="ScreenGlowOverlay"
                                 Access="Public"
                                 MouseFilter="Ignore"
                                 HorizontalExpand="True"
                                 VerticalExpand="True"
                                 Stretch="Scale"
                                 TexturePath="/Textures/Interface/Nano/square_black.png"/>
                </Control>
            </Control>
            <!-- ═══ END SCREEN AREA ═══ -->

            <!-- Screen bezel outer edge (bottom) -->
            <PanelContainer StyleClasses="PdaCaseBezelEdge" SetHeight="3" HorizontalExpand="True" Margin="8 0" />

            <!-- Footer -->
            <BoxContainer Orientation="Horizontal" SetHeight="28">
                <Label Text="{Loc 'comp-pda-ui-footer'}" StyleClasses="PdaWindowFooterText" Margin="16 0 0 6"/>
            </BoxContainer>
        </BoxContainer>

        <!-- Body → Wing junction seam (reversed shadow direction) -->
        <PanelContainer StyleClasses="PdaCaseSeamShadow" SetWidth="2" VerticalExpand="True" />
        <PanelContainer StyleClasses="PdaCaseSeamHighlight" SetWidth="1" VerticalExpand="True" />

        <!-- ▐ RIGHT: Accessory Wing ▐ -->
        <PanelContainer StyleClasses="PdaCaseWingBg" SetWidth="58" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">

                <!-- Antenna assembly -->
                <BoxContainer Orientation="Vertical" HorizontalAlignment="Center" Margin="0 0 4 0">
                    <!-- Antenna tip (narrow metal rod) -->
                    <PanelContainer StyleClasses="PdaCaseAntennaTip" SetWidth="8" SetHeight="22"
                                    HorizontalAlignment="Center" />
                    <!-- Antenna base (wider mount block) -->
                    <PanelContainer StyleClasses="PdaCaseAntennaBase" SetWidth="24" SetHeight="30"
                                    HorizontalAlignment="Center" />
                </BoxContainer>

                <Control SetHeight="12" />

                <!-- LED indicator panel — hard shadow technique -->
                <Control HorizontalExpand="True" Margin="4 0 8 0">
                    <PanelContainer StyleClasses="PdaCaseLedPanelShadow" Margin="3 3 0 0" />
                    <PanelContainer StyleClasses="PdaCaseLedPanelBody" Margin="0 0 3 3">
                        <BoxContainer Orientation="Vertical" Margin="8 10" HorizontalExpand="True"
                                      VerticalExpand="True">
                            <PanelContainer StyleClasses="PdaCaseLedAmber" SetHeight="9"
                                            HorizontalExpand="True" Margin="2 0" />
                            <Control SetHeight="5" />
                            <PanelContainer StyleClasses="PdaCaseLedYellow" SetHeight="9"
                                            HorizontalExpand="True" Margin="2 0" />
                            <Control SetHeight="5" />
                            <PanelContainer StyleClasses="PdaCaseLedGreen" SetHeight="9"
                                            HorizontalExpand="True" Margin="2 0" />
                            <Control SetHeight="5" />
                            <PanelContainer StyleClasses="PdaCaseLedRed" SetHeight="9"
                                            HorizontalExpand="True" Margin="2 0" />
                        </BoxContainer>
                    </PanelContainer>
                </Control>

                <Control SetHeight="14" />

                <!-- Stylus / pen slot — hard shadow technique -->
                <Control VerticalExpand="True" Margin="10 0 12 0">
                    <PanelContainer StyleClasses="PdaCaseStylusShadow" Margin="2 2 0 0" />
                    <PanelContainer StyleClasses="PdaCaseStylusBody" Margin="0 0 2 2" />
                </Control>

                <!-- Bottom wing angular accent -->
                <PanelContainer StyleClasses="PdaCaseWingAccent" SetHeight="30"
                                HorizontalExpand="True" Margin="0 0 8 6" />
            </BoxContainer>
        </PanelContainer>

    </BoxContainer>
</pda:PdaWindow>
