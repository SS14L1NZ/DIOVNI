<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'station-radio-menu-title'}"
                      MinSize="220 120"
                      SetSize="220 120">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="8">
        <Label Name="BroadcastNameLabel" Text="{Loc 'station-radio-menu-broadcast-name'}" />
        <LineEdit Name="BroadcastNameLineEdit" />
        <Label Text="{Loc 'station-radio-menu-frequency'}" />
        <LineEdit Name="FrequencyLineEdit" />
        <Button Name="ActiveButton"
                Margin="0 8 0 0"
                ToggleMode="True"
                Text="{Loc 'station-radio-menu-active'}" />
    </BoxContainer>
</controls:FancyWindow>
